@using PagedList;
@using PagedList.Mvc;
@model IPagedList<M1APP.Models.Gestionnaire>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Gestionnaires</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item">parametrage</li>
            <li class="breadcrumb-item active"><a href=@Url.Action("Index","Gestionnaires")>Gestionnaires</a></li>
        </ol>
    </nav>
</div>





<p>
    @Html.ActionLink("Create New", "Create", null, new { @style = "background-color: #2196F3; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; transition: background-color 0.3s;", onmouseover = "this.style.backgroundColor='#1e88e5'", onmouseout = "this.style.backgroundColor='#2196F3'" })
</p>


<!-- Formulaire de recherche -->
@using (Html.BeginForm("Index", "Gestionnaires", FormMethod.Get))
{
    <div class="form-group" style="margin-bottom: 20px;">
        <label for="cni" style="font-weight: bold; margin-bottom: 5px; display: block;">Recherche par CNI:</label>
        <input type="text" name="cni" value="@ViewBag.CNI" class="form-control" placeholder="Entrez le CNI" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-shadow: inset 0 1px 3px rgba(0,0,0,.12); transition: border-color .3s, box-shadow .3s;" />
    </div>
    <button type="submit" class="btn btn-primary" style="background-color: #2196F3; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; transition: background-color .3s;">
        Rechercher
    </button>
}

<table class="table" style="width: 100%; border-collapse: collapse; margin-top: 20px; animation: fadeIn 1s ease-in;">
    <tr style="background-color: #f2f2f2;">
        <th style="padding: 12px; text-align: left; background-color: #2196F3; color: white;">@Html.DisplayNameFor(model => model.First().NomUtilisateur)</th>
        <th style="padding: 12px; text-align: left; background-color: #2196F3; color: white;">@Html.DisplayNameFor(model => model.First().PrenomUtilisateur)</th>
        <th style="padding: 12px; text-align: left; background-color: #2196F3; color: white;">@Html.DisplayNameFor(model => model.First().EmailUtilisateur)</th>
        <th style="padding: 12px; text-align: left; background-color: #2196F3; color: white;">@Html.DisplayNameFor(model => model.First().TelUtilisateur)</th>
        <th style="padding: 12px; text-align: left; background-color: #2196F3; color: white;">@Html.DisplayNameFor(model => model.First().CNIGestionnaire)</th>
        <th style="padding: 12px; text-align: left; background-color: #2196F3; color: white;">Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr style="border-bottom: 1px solid #ddd; transition: background-color 0.3s;" onmouseover="this.style.backgroundColor='#f9f9f9'" onmouseout="this.style.backgroundColor='white'">
            <td style="padding: 12px; text-align: left;">@Html.DisplayFor(modelItem => item.NomUtilisateur)</td>
            <td style="padding: 12px; text-align: left;">@Html.DisplayFor(modelItem => item.PrenomUtilisateur)</td>
            <td style="padding: 12px; text-align: left;">@Html.DisplayFor(modelItem => item.EmailUtilisateur)</td>
            <td style="padding: 12px; text-align: left;">@Html.DisplayFor(modelItem => item.TelUtilisateur)</td>
            <td style="padding: 12px; text-align: left;">@Html.DisplayFor(modelItem => item.CNIGestionnaire)</td>
            <td style="padding: 12px; text-align: left;">
                @Html.ActionLink("Edit", "Edit", new { id = item.IdUtilisateur }, new { @style = "background-color: #2196F3; color: white; padding: 5px 10px; border-radius: 3px; text-decoration: none; transition: background-color 0.3s;", onmouseover = "this.style.backgroundColor='#1e88e5'", onmouseout = "this.style.backgroundColor='#2196F3'" })
                @Html.ActionLink("Details", "Details", new { id = item.IdUtilisateur }, new { @style = "background-color: #4CAF50; color: white; padding: 5px 10px; border-radius: 3px; text-decoration: none; transition: background-color 0.3s;", onmouseover = "this.style.backgroundColor='#45a049'", onmouseout = "this.style.backgroundColor='#4CAF50'" })
                @Html.ActionLink("Delete", "Delete", new { id = item.IdUtilisateur }, new { @style = "background-color: #f44336; color: white; padding: 5px 10px; border-radius: 3px; text-decoration: none; transition: background-color 0.3s;", onmouseover = "this.style.backgroundColor='#e53935'", onmouseout = "this.style.backgroundColor='#f44336'" })
            </td>
        </tr>
    }
</table>

<!-- Pagination -->
<div>
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, cni = ViewBag.CNI }))
</div>

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>
