@model M1APP.Models.Gestionnaire

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="background-color: #f9f9f9; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
        <h4 style="color: #333; font-weight: bold; text-align: center;">Gestionnaire</h4>
        <hr style="border: 1px solid #ddd;" />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.NomUtilisateur, htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold; color: #555;" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NomUtilisateur, new { htmlAttributes = new { @class = "form-control", style = "border: 1px solid #ccc; border-radius: 5px; padding: 10px;" } })
                @Html.ValidationMessageFor(model => model.NomUtilisateur, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.PrenomUtilisateur, htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold; color: #555;" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.PrenomUtilisateur, new { htmlAttributes = new { @class = "form-control", style = "border: 1px solid #ccc; border-radius: 5px; padding: 10px;" } })
                @Html.ValidationMessageFor(model => model.PrenomUtilisateur, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.EmailUtilisateur, htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold; color: #555;" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.EmailUtilisateur, new { htmlAttributes = new { @class = "form-control", style = "border: 1px solid #ccc; border-radius: 5px; padding: 10px;" } })
                @Html.ValidationMessageFor(model => model.EmailUtilisateur, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.PasswordUtilisateur, htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold; color: #555;" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.PasswordUtilisateur, new { htmlAttributes = new { @class = "form-control", style = "border: 1px solid #ccc; border-radius: 5px; padding: 10px;" } })
                @Html.ValidationMessageFor(model => model.PasswordUtilisateur, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.TelUtilisateur, htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold; color: #555;" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.TelUtilisateur, new { htmlAttributes = new { @class = "form-control", style = "border: 1px solid #ccc; border-radius: 5px; padding: 10px;" } })
                @Html.ValidationMessageFor(model => model.TelUtilisateur, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            @Html.LabelFor(model => model.CNIGestionnaire, htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold; color: #555;" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CNIGestionnaire, new { htmlAttributes = new { @class = "form-control", style = "border: 1px solid #ccc; border-radius: 5px; padding: 10px;" } })
                @Html.ValidationMessageFor(model => model.CNIGestionnaire, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-top: 20px; text-align: center;">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-primary" style="background-color: #4CAF50; border: none; padding: 10px 20px; color: white; font-weight: bold; border-radius: 5px; cursor: pointer;" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary", style = "background-color: #2196F3; color: white; padding: 10px 20px; border-radius: 5px; text-decoration: none; font-weight: bold;" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
