@using M1APP.Models
@model LoginViewModel
@{
    ViewBag.Title = "Se connecter";
}

<main aria-labelledby="title" style="font-family: Arial, sans-serif; background-color: #f5f5f5; padding: 20px;">
    <h2 id="title" style="color: #333; text-align: center;">@ViewBag.Title.</h2>
    <div class="row" style="display: flex; justify-content: center;">
        <div class="col-md-8" style="max-width: 600px; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);">
            <section id="loginForm">
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    <h4 style="color: #555; text-align: center;">Connectez-vous à l'aide d'un compte local.</h4>
                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row" style="margin-bottom: 15px;">
                        @Html.LabelFor(m => m.Email, new { @class = "col-md-2 col-form-label", style = "color: #555;" })
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", style = "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row" style="margin-bottom: 15px;">
                        @Html.LabelFor(m => m.Password, new { @class = "col-md-2 col-form-label", style = "color: #555;" })
                        <div class="col-md-10">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", style = "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row" style="margin-bottom: 15px;">
                        <div class="offset-md-2 col-md-10">
                            <div class="checkbox" style="display: flex; align-items: center;">
                                @Html.CheckBoxFor(m => m.RememberMe, new { style = "margin-right: 10px;" })
                                @Html.LabelFor(m => m.RememberMe, new { style = "color: #555;" })
                            </div>
                        </div>
                    </div>
                    <div class="row" style="margin-bottom: 15px;">
                        <div class="offset-md-2 col-md-10">
                            <input type="submit" value="Se connecter" class="btn btn-outline-dark" style="background-color: #007bff; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;" />
                        </div>
                    </div>
                    <p style="text-align: center;">
                        @Html.ActionLink("Inscrire comme nouvel utilisateur", "Register", null, new { @style = "color: #007bff; text-decoration: none;" })
                    </p>
                    //Activez ceci une fois que vous avez activé la confirmation du compte pour la fonctionnalité de réinitialisation du mot de passe
                        <p style="text-align: center;">
                            @Html.ActionLink("Vous avez oublié votre mot de passe ?", "ForgotPassword", null, new { @style = "color: #007bff; text-decoration: none;" })
                        </p>
                }
            </section>
        </div>
        <div class="col-md-4" style="max-width: 300px; margin-top: 20px;">
            <section id="socialLoginForm">
                @Html.Partial("_ExternalLoginsListPartial", new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl })
            </section>
        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
