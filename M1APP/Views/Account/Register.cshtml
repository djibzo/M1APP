@model M1APP.Models.RegisterViewModel
@{
    ViewBag.Title = "S'inscrire";
}

<main aria-labelledby="title" style="font-family: Arial, sans-serif; background-color: #f5f5f5; padding: 20px;">
    <h2 id="title" style="color: #333; text-align: center;">@ViewBag.Title.</h2>

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        <h4 style="color: #555; text-align: center;">Créez un nouveau compte.</h4>
        <hr />
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="row" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Email, new { @class = "col-md-2 col-form-label", style = "color: #555;" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", style = "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
            </div>
        </div>
        <div hidden class="row" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.Password, new { @class = "col-md-2 col-form-label", style = "color: #555;" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", value="P@sser123", style = "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
            </div>
        </div>
        <div hidden class="row" style="margin-bottom: 15px;">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-2 col-form-label", style = "color: #555;" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", value="P@sser123", style = "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" })
            </div>
        </div>
        <div class="row" style="margin-bottom: 15px;">
            <div class="offset-md-2 col-md-10">
                <input type="submit" value="S'inscrire" class="btn btn-outline-dark" style="background-color: #007bff; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;" />
            </div>
        </div>
    }
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
