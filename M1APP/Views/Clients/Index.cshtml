@model IEnumerable<M1APP.Models.Client>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Clients</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item">parametrage</li>
            <li class="breadcrumb-item active"><a href=@Url.Action("Index","Clients")>Clients</a></li>
        </ol>
    </nav>
</div>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.CniClient)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NomUtilisateur)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PrenomUtilisateur)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EmailUtilisateur)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PasswordUtilisateur)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TelUtilisateur)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CniClient)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NomUtilisateur)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PrenomUtilisateur)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EmailUtilisateur)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PasswordUtilisateur)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TelUtilisateur)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.IdUtilisateur }) |
            @Html.ActionLink("Details", "Details", new { id=item.IdUtilisateur }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.IdUtilisateur })
        </td>
    </tr>
}

</table>
