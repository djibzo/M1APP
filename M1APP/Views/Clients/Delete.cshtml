@model M1APP.Models.Client

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="color: #d9534f; font-weight: bold;">Delete</h2>

<h3 style="color: #f0ad4e;">Are you sure you want to delete this?</h3>
<div style="background-color: #f9f9f9; padding: 20px; border-radius: 5px; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
    <h4 style="color: #5bc0de;">Client</h4>
    <hr />
    <dl class="dl-horizontal" style="margin-bottom: 20px;">
        <dt style="font-weight: bold;">
            @Html.DisplayNameFor(model => model.CniClient)
        </dt>
        <dd style="margin-bottom: 10px;">
            @Html.DisplayFor(model => model.CniClient)
        </dd>

        <dt style="font-weight: bold;">
            @Html.DisplayNameFor(model => model.NomUtilisateur)
        </dt>
        <dd style="margin-bottom: 10px;">
            @Html.DisplayFor(model => model.NomUtilisateur)
        </dd>

        <dt style="font-weight: bold;">
            @Html.DisplayNameFor(model => model.PrenomUtilisateur)
        </dt>
        <dd style="margin-bottom: 10px;">
            @Html.DisplayFor(model => model.PrenomUtilisateur)
        </dd>

        <dt style="font-weight: bold;">
            @Html.DisplayNameFor(model => model.EmailUtilisateur)
        </dt>
        <dd style="margin-bottom: 10px;">
            @Html.DisplayFor(model => model.EmailUtilisateur)
        </dd>

        <dt style="font-weight: bold;">
            @Html.DisplayNameFor(model => model.PasswordUtilisateur)
        </dt>
        <dd style="margin-bottom: 10px;">
            @Html.DisplayFor(model => model.PasswordUtilisateur)
        </dd>

        <dt style="font-weight: bold;">
            @Html.DisplayNameFor(model => model.TelUtilisateur)
        </dt>
        <dd style="margin-bottom: 10px;">
            @Html.DisplayFor(model => model.TelUtilisateur)
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color" style="margin-top: 20px;">
            <input type="submit" value="Delete" class="btn btn-danger" style="background-color: #d9534f; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; transition: background-color .3s;" /> |
            @Html.ActionLink("Back to List", "Index", null, new { @style = "background-color: #5bc0de; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; transition: background-color .3s;" })
        </div>
    }
</div>
