<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="aspnet:UseTaskFriendlySynchroniza=onContext" value="true" />
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime maxRequestLength="2147483647"
		useFullyQualifiedRedirectUrl="true"
		executionTimeout="14400" targetFramework="4.8"/>
	</system.web>
	<system.serviceModel>
		<behaviors>
			<serviceBehaviors>
				<behavior>
					<!-- Pour éviter la divulga=on d'informa=ons de métadonnées, définissez les valeurs ci-dessous sur false avant le déploiement -->
					<serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>
					<!-- Pour recevoir les détails de l'excep=on dans les erreurs à des fins de débogage, affectez true à la valeur cidessous. Affectez-lui false avant le déploiement afin d'éviter de dévoiler des informa=ons d'excep=on -->
					<serviceDebug includeExceptionDetailInFaults="false"/>
				</behavior>
			</serviceBehaviors>
		</behaviors>
		<protocolMapping>
			<add binding="basicHttpsBinding" scheme="https" />
		</protocolMapping>
		<serviceHostingEnvironment aspNetCompatbilityEnabled="true" multipleSiteBindingsEnabled="true" />
		<bindings>
			<basicHttpBinding>
				<binding name="BasicHttpBinding_IService1"
			   maxReceivedMessageSize="2147483647"
			   maxBufferSize="2147483647" transferMode="Streamed" >
					<readerQuotas maxDepth="2147483647"
				   maxStringContentLength="2147483647"
					maxArrayLength="2147483647" maxBytesPerRead="2147483647"
					maxNameTableCharCount="2147483647"/>
				</binding>
			</basicHttpBinding>
		</bindings>
		<services>
			<service name="ServiceFile.Service1">
				<endpoint address="Service1.svc" binding="basicHttpBinding"
			   bindingConfiguration="BasicHTTpBinding_IService1"
			   contract ="ServiceFile.IService1">
				</endpoint>
			</service>
		</services>
	</system.serviceModel>
	<system.webServer>
		<modules runAllManagedModulesForAllRequests="true"/>

		<directoryBrowse enabled="true"/>
	</system.webServer>
	</configuration>